{
	"schemaVersion": 1,
	"id": "suitcraft",
	"version": "${version}",
	"name": "Anzug-Werkstatt",
	"description": "Vier craftbare Anzüge mit Fähigkeiten: Netzläufer, Glutpanzer, Schattenmantel und Sturmflügel.",
	"authors": [
		"hxpexlss"
	],
	"license": "CC0-1.0",
	"icon": "assets/suitcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.suitcraft.SuitcraftMod"
		],
		"client": [
			"de.suitcraft.client.SuitcraftClient"
		]
	},
	"mixins": [
		"suitcraft.mixins.json",
		{
			"config": "suitcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
