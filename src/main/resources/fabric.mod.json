{
	"schemaVersion": 1,
	"id": "chaosblock",
	"version": "${version}",
	"name": "Chaos-Block",
	"description": "Irgendein Block ist verflucht. Welcher? Das verrät nur das Orakel-Auge. Baust du ihn ab, passiert etwas – gut, schlecht oder einfach nur seltsam.",
	"authors": [
		"hxpexlss"
	],
	"license": "CC0-1.0",
	"icon": "assets/chaosblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.chaosblock.ChaosBlockMod"
		],
		"client": [
			"de.chaosblock.client.ChaosBlockClient"
		]
	},
	"mixins": [
		"chaosblock.mixins.json",
		{
			"config": "chaosblock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
